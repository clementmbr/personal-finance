<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_currency_rate_list_personal" model="ir.ui.view">
        <field name="name">res.currency.rate.list.personal</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="name desc" expand="1" import="1">
                <field name="name" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="company_rate" digits="[12,12]" />
                <field name="inverse_company_rate" digits="[12,12]" />
                <field name="rate" digits="[12,12]" optional="hide" />
                <field name="write_date" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_currency_rate_search_personal" model="ir.ui.view">
        <field name="name">res.currency.rate.search.personal</field>
        <field name="model">res.currency.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id" />
                <filter
                    string="EUR"
                    name="filter_eur"
                    domain="[('currency_id.name', '=', 'EUR')]"
                />
                <filter
                    string="BRL"
                    name="filter_brl"
                    domain="[('currency_id.name', '=', 'BRL')]"
                />
                <group expand="1" string="Group By">
                    <filter
                        string="Currency"
                        name="group_by_currency_id"
                        context="{'group_by': 'currency_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_personal_currency_rates" model="ir.actions.act_window">
        <field name="name">Currency Rates</field>
        <field name="res_model">res.currency.rate</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_currency_rate_list_personal" />
        <field name="search_view_id" ref="view_currency_rate_search_personal" />
        <field name="context">{
            'search_default_filter_eur': 1,
            'search_default_filter_brl': 1,
            'search_default_group_by_currency_id': 1
        }</field>
    </record>

    <menuitem
        id="menu_personal_currencies"
        name="Currencies"
        parent="account_personal_finance.menu_personal_finance_config"
        action="base.action_currency_form"
        sequence="50"
    />

    <menuitem
        id="menu_personal_currency_rates"
        name="Exchange Rates"
        parent="account_personal_finance.menu_personal_finance_config"
        action="action_personal_currency_rates"
        sequence="60"
    />
</odoo>
