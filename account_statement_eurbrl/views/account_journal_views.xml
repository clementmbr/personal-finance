<odoo>
    <record id="view_account_journal_tree_inherit" model="ir.ui.view">
        <field name="name">account.journal.list.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="current_statement_balance_eur" optional="hide" />
                <field name="current_statement_balance_brl" optional="hide" />
                <field name="currency_eur_id" column_invisible="True" />
                <field name="currency_brl_id" column_invisible="True" />
            </xpath>
        </field>
    </record>
</odoo>
