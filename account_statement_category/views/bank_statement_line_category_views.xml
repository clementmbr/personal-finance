<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_bank_statement_line_category_list" model="ir.ui.view">
        <field name="name">bank.statement.line.category.list</field>
        <field name="model">bank.statement.line.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="parent_id" />
                <field name="background_color" widget="color" invisible="parent_id" />
                <field name="text_color" widget="color" invisible="parent_id" />
                <field name="is_expense" />
            </list>
        </field>
    </record>

    <record id="action_bank_statement_line_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">bank.statement.line.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain" />
        <field name="context" />
    </record>
</odoo>
