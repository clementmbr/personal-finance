<odoo>
    <record id="view_account_statement_report_pivot" model="ir.ui.view">
        <field name="model">account.statement.balance.report</field>
        <field name="arch" type="xml">
            <pivot string="Monthly Balances">
                <field name="journal_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="balance" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_account_statement_report_graph" model="ir.ui.view">
        <field name="model">account.statement.balance.report</field>
        <field name="arch" type="xml">
            <graph string="Balances Evolution" type="line" sample="1" stacked="True">
                <field name="date" interval="month" />
                <field name="balance" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_account_statement_report_search" model="ir.ui.view">
        <field name="name">account.statement.report.search</field>
        <field name="model">account.statement.balance.report</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Last year"
                    name="last_year"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(months=12)).strftime('%Y-%m-%d'))]"
                />
                <separator />
            </search>
        </field>
    </record>

    <record id="action_account_statement_report" model="ir.actions.act_window">
        <field name="name">Monthly Balances</field>
        <field name="res_model">account.statement.balance.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_last_year': 1}</field>
    </record>

    <menuitem
        id="menu_account_statement_report"
        name="Monthly Balances"
        action="action_account_statement_report"
        parent="account_statement_category.menu_personal_finance_root"
        sequence="30"
    />
</odoo>
