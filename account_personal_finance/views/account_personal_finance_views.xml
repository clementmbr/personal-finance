<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_personal_bank_journal_dashboard" model="ir.actions.act_window">
        <field name="name">Bank Dashboard</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="usage">menu</field>
        <field name="domain">[('type', '=', 'bank')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your bank journals.
            </p>
        </field>
    </record>

    <record id="view_account_journal_tree_inherit" model="ir.ui.view">
        <field name="name">account.journal.list.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="current_statement_balance" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="action_compute_journals_current_balance" model="ir.actions.server">
        <field name="name">Compute current balances</field>
        <field name="model_id" ref="account.model_account_journal" />
        <field name="binding_model_id" ref="account.model_account_journal" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_compute_journals_current_balance()
        </field>
    </record>

    <record id="action_compute_lines_running_balance" model="ir.actions.server">
        <field name="name">Compute statement lines running balances</field>
        <field name="model_id" ref="account.model_account_journal" />
        <field name="binding_model_id" ref="account.model_account_journal" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_compute_lines_running_balance()
        </field>
    </record>

    <menuitem
        id="menu_personal_finance_root"
        name="My Finances"
        sequence="1"
        web_icon="account_personal_finance,static/description/icon.png"
    />

    <menuitem
        id="menu_personal_bank_journal_dashboard"
        name="Bank Accounts"
        parent="menu_personal_finance_root"
        action="action_personal_bank_journal_dashboard"
        sequence="5"
    />

    <menuitem
        id="menu_personal_finance_config"
        name="Configuration"
        parent="menu_personal_finance_root"
        sequence="100"
    />

    <menuitem
        id="menu_personal_account_journal"
        name="Journals"
        parent="menu_personal_finance_config"
        action="account.action_account_journal_form"
        sequence="20"
    />

    <menuitem
        id="account_banks_menu_personal"
        name="Banks"
        parent="menu_personal_finance_config"
        sequence="100"
    />

    <menuitem
        id="menu_personal_bank_statements"
        name="Bank Statements"
        parent="account_banks_menu_personal"
        action="account.action_bank_statement_tree"
        sequence="5"
    />

    <menuitem
        id="menu_personal_new_bank_account"
        name="Add a Bank Account"
        parent="account_banks_menu_personal"
        action="account.action_new_bank_setting"
        sequence="10"
    />

    <menuitem
        id="menu_personal_res_partner_bank"
        name="Bank Accounts"
        parent="account_banks_menu_personal"
        action="base.action_res_partner_bank_account_form"
        sequence="20"
    />
</odoo>
